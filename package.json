{
  "name": "item-finder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:reset": "node -e \"require('fs').rmSync('data/itemfinder.db',{force:true})\" && tsx scripts/migrate.ts",
    "crawl": "tsx scripts/crawl.ts",
    "score": "tsx scripts/score.ts",
    "schedule": "tsx scripts/schedule.ts",
    "stores": "tsx scripts/stores.ts",
    "enrich": "tsx scripts/enrich.ts",
    "test": "tsx --test scripts/selftest.ts",
    "reference": "tsx scripts/reference.ts",
    "ci:cycle": "tsx scripts/ci-cycle.ts",
    "audit": "tsx scripts/audit.ts",
    "export:public": "tsx scripts/export-public.ts",
    "sitemaps": "tsx scripts/sitemaps.ts",
    "brands": "tsx scripts/brands.ts",
    "specs": "tsx scripts/specs.ts",
    "sync": "tsx scripts/sync.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "better-sqlite3": "^13.0.3",
    "fzstd": "^0.1.1",
    "next": "^16.3.3",
    "playwright-core": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "undici": "^8.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  }
}
